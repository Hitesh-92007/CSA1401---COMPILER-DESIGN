%{
#include <stdio.h>
#include <string.h>

int count = 0;

int palindrome(char *s)
{
    int i, j;
    for(i = 0, j = strlen(s)-1; i < j; i++, j--)
        if(s[i] != s[j])
            return 0;
    return 1;
}
%}

%%
[A-Za-z]+ {
    if(palindrome(yytext))
    {
        printf("Palindrome: %s\n", yytext);
        count++;
    }
}
[ \t\n]+ ;
. ;
%%

int main()
{
    printf("Enter words:\n");
    yylex();
    printf("Number of Palindrome Words = %d\n", count);
    return 0;
}
